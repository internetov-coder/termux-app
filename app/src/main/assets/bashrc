show_menu() {
    clear
    cat << 'EOF'
 _______                               __  __
 |__   __|                             |  \/  |
    | | ___ _ __ _ __ ___  _   ___  __ | \  / | ___ _ __  _   _
    | |/ _ \ '__| '_ ` _ \| | | \ \/ / | |\/| |/ _ \ '_ \| | | |
    | |  __/ |  | | | | | | |_| |>  <  | |  | |  __/ | | | |_| |
    |_\___|_|  |_| |_| |_|\__,_/_/\_\ |_|  |_|\___|_| |_|\__,_|

EOF
    echo "=================================="
    echo "         TERMUX MENU"
    echo "=================================="
    echo "1. PerfManager"
    echo "2. Chroot Ubuntu"
    echo "3. Termux Shell"
    echo "=================================="
    echo -n "Выбери опцию (1-3): "
}

# Меню работает в каждой сессии (убрал проверку MENU_SHOWN)
while true; do
    show_menu
    read choice

    case $choice in
        1)
            echo "Запуск PerfManager..."
            su -c perfmanager
            ;;
        2)
            echo "Запуск Chroot Ubuntu..."
            su -c /data/local/tmp/start.sh
            ;;
        3)
            echo "Termux Shell"
            break
            ;;
        *)
            echo "Неверный выбор, попробуй снова..."
            sleep 1
            ;;
    esac
done
